# Copy to /opt/myheritage/.env.production and adjust values.
# Used by docker compose --env-file and by api/workers containers.

POSTGRES_USER=heritage
POSTGRES_PASSWORD=HeritagePg!2026
POSTGRES_DB=heritage

# Prisma / app DB URL (host `postgres` is the compose service name)
DATABASE_URL=postgresql://heritage:HeritagePg!2026@postgres:5432/heritage

API_PORT=4000
WEB_ORIGIN=http://46.202.163.202:3000,http://46.202.163.202,http://localhost:3000
# Browser calls same-origin /__api; Next proxies to the api container.
NEXT_PUBLIC_API_URL=/__api
API_PROXY_TARGET=http://api:4000

SESSION_SECRET=change-me-session-secret-prod
JWT_SECRET=change-me-jwt-secret-prod

# Mail + Ask Heritage (Humanitix)
HUMANITIX_SEND_MAIL_URL=https://onlinemandiapp.com/Humanitix/api/send_mail
HUMANITIX_ASK_URL=https://onlinemandiapp.com/Humanitix/api/ask
EXPOSE_RESET_TOKEN=1

NODE_ENV=production
