generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  legalName     String
  timezone      String   @default("America/Vancouver")
  currency      String   @default("CAD")
  addressLine1  String
  city          String
  region        String
  postalCode    String
  country       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
}

model Person {
  id            String    @id @default(uuid())
  institutionId String
  givenName     String
  familyName    String
  email         String
  dateOfBirth   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  accounts      Account[]
  students      Student[]

  @@unique([institutionId, email])
  @@index([institutionId])
}

model Account {
  id            String         @id @default(uuid())
  institutionId String
  personId      String
  email         String
  passwordHash  String
  status        String         @default("active")
  mfaEnabled    Boolean        @default(false)
  timezone      String         @default("America/Vancouver")
  rolesJson     String         @default("[]")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  rowVersion    Int            @default(1)
  person        Person         @relation(fields: [personId], references: [id])
  sessions      Session[]
  notifications Notification[]
  aiInteractions AiInteraction[]

  @@unique([institutionId, email])
  @@index([institutionId])
}

model Session {
  id                String   @id @default(uuid())
  institutionId     String
  accountId         String
  deviceFingerprint String
  ipAddress         String
  userAgent         String
  geoLocation       String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rowVersion        Int      @default(1)
  account           Account  @relation(fields: [accountId], references: [id])

  @@index([institutionId])
  @@index([accountId])
}

model SecurityPolicy {
  id                         String   @id @default(uuid())
  institutionId              String   @unique
  maxConcurrentSessions      Int      @default(3)
  sharedIpAlertWindowMinutes Int      @default(5)
  adminIpAllowlistCidrsJson  String   @default("[]")
  passwordMinLength          Int      @default(10)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  rowVersion                 Int      @default(1)
}

model Student {
  id               String            @id @default(uuid())
  institutionId    String
  personId         String
  studentNumber    String
  programName      String
  programVersionId String?
  standing         String            @default("good")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rowVersion       Int               @default(1)
  person           Person            @relation(fields: [personId], references: [id])
  programVersion   ProgramVersion?   @relation(fields: [programVersionId], references: [id])
  enrolments       Enrolment[]
  gradeItems       GradeItem[]
  submissions      Submission[]
  degreeScenarios  DegreePlanScenario[]
  advisingAppointments AdvisingAppointment[]
  successCases     SuccessCase[]
  transferCredits  TransferCredit[]
  assessmentAttempts AssessmentAttempt[]
  attendanceRecords  AttendanceRecord[]
  labNotebookEntries LabNotebookEntry[]
  serviceRequests    ServiceRequest[]
  financeLedgerEntries FinanceLedgerEntry[]
  credentialRecords  CredentialRecord[]
  placements         Placement[]

  @@unique([institutionId, studentNumber])
  @@index([institutionId])
  @@index([programVersionId])
}

model Program {
  id            String           @id @default(uuid())
  institutionId String
  code          String
  name          String
  awardLevel    String           @default("diploma")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rowVersion    Int              @default(1)
  versions      ProgramVersion[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model ProgramVersion {
  id            String              @id @default(uuid())
  institutionId String
  programId     String
  label         String
  effectiveOn   String
  totalCredits  Float
  status        String              @default("active")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  rowVersion    Int                 @default(1)
  program       Program             @relation(fields: [programId], references: [id])
  requirements  DegreeRequirement[]
  students      Student[]

  @@unique([institutionId, programId, label])
  @@index([institutionId])
}

model DegreeRequirement {
  id               String         @id @default(uuid())
  institutionId    String
  programVersionId String
  courseId         String?
  courseCode       String
  title            String
  credits          Float
  kind             String         @default("required")
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rowVersion       Int            @default(1)
  programVersion   ProgramVersion @relation(fields: [programVersionId], references: [id])
  course           Course?        @relation(fields: [courseId], references: [id])

  @@index([institutionId, programVersionId])
  @@index([institutionId, courseCode])
}

model CoursePrerequisite {
  id                 String   @id @default(uuid())
  institutionId      String
  courseId           String
  prerequisiteCourseId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  rowVersion         Int      @default(1)
  course             Course   @relation("CourseHasPrereqs", fields: [courseId], references: [id])
  prerequisiteCourse Course   @relation("CourseIsPrereq", fields: [prerequisiteCourseId], references: [id])

  @@unique([institutionId, courseId, prerequisiteCourseId])
  @@index([institutionId])
}

model DegreePlanScenario {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  label         String
  assumptionsJson String
  resultJson    String
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  student       Student  @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, createdAt])
}

model KnowledgeDocument {
  id            String   @id @default(uuid())
  institutionId String
  slug          String
  title         String
  docType       String
  body          String
  uri           String
  versionLabel  String   @default("1")
  status        String   @default("published")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@unique([institutionId, slug])
  @@index([institutionId, docType])
}

model Term {
  id            String    @id @default(uuid())
  institutionId String
  code          String
  name          String
  startsOn      String
  endsOn        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  sections      Section[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Course {
  id            String               @id @default(uuid())
  institutionId String
  code          String
  title         String
  credits       Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  rowVersion    Int                  @default(1)
  sections      Section[]
  requirements  DegreeRequirement[]
  prereqFor     CoursePrerequisite[] @relation("CourseHasPrereqs")
  isPrereqOf    CoursePrerequisite[] @relation("CourseIsPrereq")
  coreqFor      CourseCorequisite[]  @relation("CourseHasCoreqs")
  isCoreqOf     CourseCorequisite[]  @relation("CourseIsCoreq")
  offerings     CourseOffering[]
  transferCredits TransferCredit[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Section {
  id                 String         @id @default(uuid())
  institutionId      String
  courseId           String
  termId             String
  code               String
  instructorPersonId String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  rowVersion         Int            @default(1)
  course             Course         @relation(fields: [courseId], references: [id])
  term               Term           @relation(fields: [termId], references: [id])
  enrolments         Enrolment[]
  assignments        Assignment[]
  classSessions      ClassSession[]
  assessments        Assessment[]
  attendanceRecords  AttendanceRecord[]

  @@index([institutionId])
}

model Enrolment {
  id            String      @id @default(uuid())
  institutionId String
  sectionId     String
  studentId     String
  status        String      @default("enrolled")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rowVersion    Int         @default(1)
  section       Section     @relation(fields: [sectionId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])
  gradeItems    GradeItem[]

  @@unique([sectionId, studentId])
  @@index([institutionId])
}

model Assignment {
  id            String       @id @default(uuid())
  institutionId String
  sectionId     String
  title         String
  maxScore      Float
  weightPercent Float
  dueAt         DateTime?
  rubricId      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rowVersion    Int          @default(1)
  section       Section      @relation(fields: [sectionId], references: [id])
  rubric        Rubric?      @relation(fields: [rubricId], references: [id])
  gradeItems    GradeItem[]
  submissions   Submission[]

  @@index([institutionId])
  @@index([rubricId])
}

model Submission {
  id            String       @id @default(uuid())
  institutionId String
  assignmentId  String
  studentId     String
  submittedAt   DateTime?
  status        String       @default("draft")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rowVersion    Int          @default(1)
  assignment    Assignment   @relation(fields: [assignmentId], references: [id])
  student       Student      @relation(fields: [studentId], references: [id])
  files         FileObject[]

  @@unique([assignmentId, studentId])
  @@index([institutionId])
  @@index([studentId, status])
}

model FileObject {
  id             String     @id @default(uuid())
  institutionId  String
  submissionId   String
  path           String
  filename       String
  mimeType       String
  sizeBytes      Int
  classification String     @default("confidential")
  version        Int
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  rowVersion     Int        @default(1)
  submission     Submission @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, version])
  @@index([institutionId])
  @@index([submissionId, archivedAt])
}

model ClassSession {
  id            String    @id @default(uuid())
  institutionId String
  sectionId     String
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  joinUrl       String?
  deliveryMode  String    @default("in_person")
  sessionKind   String    @default("lecture")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  section       Section   @relation(fields: [sectionId], references: [id])
  attendanceRecords AttendanceRecord[]
  labNotebookEntries LabNotebookEntry[]

  @@index([institutionId, startsAt])
  @@index([sectionId, startsAt])
  @@index([institutionId, sessionKind])
}

model GradeItem {
  id            String     @id @default(uuid())
  institutionId String
  assignmentId  String
  studentId     String
  enrolmentId   String
  score         Float?
  maxScore      Float
  letter        String?
  status        String     @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  rowVersion    Int        @default(1)
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id])
  enrolment     Enrolment  @relation(fields: [enrolmentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([institutionId])
  @@index([studentId, status])
}

model ApprovalRequest {
  id                        String   @id @default(uuid())
  institutionId             String
  type                      String
  subjectRef                String
  proposedDiffJson          String
  requestedBy               String
  requiredApproverRolesJson String
  requiredCount             Int
  status                    String   @default("pending")
  decisionsJson             String   @default("[]")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  rowVersion                Int      @default(1)

  @@index([institutionId, status])
}

model AuditEvent {
  id            String   @id @default(uuid())
  institutionId String
  actorId       String
  eventName     String
  purpose       String
  beforeJson    String?
  afterJson     String?
  source        String
  correlationId String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@index([institutionId])
  @@index([correlationId])
}

model EventOutbox {
  id            String   @id @default(uuid())
  institutionId String
  eventName     String
  payloadJson   String
  status        String   @default("pending")
  attempts      Int      @default(0)
  availableAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@index([status, availableAt])
  @@index([institutionId])
}

model Notification {
  id                 String    @id @default(uuid())
  institutionId      String
  recipientAccountId String
  channel            String
  title              String
  body               String
  readAt             DateTime?
  templateKey        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rowVersion         Int       @default(1)
  recipient          Account   @relation(fields: [recipientAccountId], references: [id])

  @@index([institutionId])
  @@index([recipientAccountId])
}

model MessageThread {
  id                        String    @id @default(uuid())
  institutionId             String
  subject                   String
  participantAccountIdsJson String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  rowVersion                Int       @default(1)
  messages                  Message[]

  @@index([institutionId])
}

model Message {
  id                 String        @id @default(uuid())
  institutionId      String
  threadId           String
  senderAccountId    String
  body               String
  relatedGradeItemId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  rowVersion         Int           @default(1)
  thread             MessageThread @relation(fields: [threadId], references: [id])

  @@index([institutionId])
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  institutionId String
  key           String
  method        String
  path          String
  responseJson  String
  statusCode    Int
  createdAt     DateTime @default(now())

  @@unique([institutionId, key, method, path])
}

model AiInteraction {
  id               String   @id @default(uuid())
  institutionId    String
  accountId        String
  role             String
  question         String
  answer           String
  sourcesJson      String
  suggestedActionsJson String @default("[]")
  tier             String   @default("read_only")
  provider         String   @default("campus_grounding_v1")
  capability       String   @default("campus_coach")
  latencyMs        Int      @default(0)
  estimatedTokens  Int      @default(0)
  resultStatus     String   @default("completed")
  status           String   @default("completed")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  rowVersion       Int      @default(1)
  account          Account  @relation(fields: [accountId], references: [id])

  @@index([institutionId, accountId, createdAt])
  @@index([institutionId, role, createdAt])
  @@index([institutionId, capability, createdAt])
}

/**
 * Live portal rows for screens without a dedicated domain table yet. Always seeded — never client-hardcoded.
 */
model PortalRecord {
  id                String   @id @default(uuid())
  institutionId     String
  screenPath        String
  role              String
  primaryText       String
  secondaryText     String?
  metaText          String?
  href              String?
  sortOrder         Int      @default(0)
  audienceAccountId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rowVersion        Int      @default(1)

  @@index([institutionId, screenPath])
  @@index([institutionId, role])
}

/**
 * Admin SIS screen live payload (rows/kpis/detail blobs). Served by GET /admin/sis/screen — never rendered from client fixtures alone.
 */
model SisScreenState {
  id            String   @id @default(uuid())
  institutionId String
  path          String
  payloadJson   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@unique([institutionId, path])
  @@index([institutionId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

model AdmissionsApplication {
  id            String   @id @default(uuid())
  institutionId String
  accountId     String
  personId      String
  programName   String
  intakeTerm    String
  status        String   @default("draft")
  progressPct   Int      @default(0)
  notes         String?
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  documents     ApplicationDocument[]
  offers        ApplicationOffer[]
  timeline      ApplicationTimelineEvent[]

  @@index([institutionId, accountId])
  @@index([institutionId, status])
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  institutionId String
  applicationId String
  label         String
  status        String   @default("missing")
  fileName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  application   AdmissionsApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([institutionId, applicationId])
}

model ApplicationOffer {
  id            String   @id @default(uuid())
  institutionId String
  applicationId String
  title         String
  status        String   @default("pending")
  conditions    String?
  expiresOn     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  application   AdmissionsApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([institutionId, applicationId])
}

model ApplicationTimelineEvent {
  id            String   @id @default(uuid())
  institutionId String
  applicationId String
  title         String
  detail        String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  application   AdmissionsApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([institutionId, applicationId])
}

model EmployerOrg {
  id            String   @id @default(uuid())
  institutionId String
  accountId     String?
  name          String
  siteName      String
  contactEmail  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  placements    Placement[]
  agreements    AffiliationAgreement[]

  @@index([institutionId])
  @@index([institutionId, accountId])
}

model Placement {
  id            String   @id @default(uuid())
  institutionId String
  employerOrgId String
  studentId     String?
  studentName   String
  programName   String
  status        String   @default("active")
  startsOn      String?
  endsOn        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  employerOrg   EmployerOrg @relation(fields: [employerOrgId], references: [id], onDelete: Cascade)
  student       Student? @relation(fields: [studentId], references: [id])
  hours         HoursEntry[]
  evaluations   PlacementEvaluation[]

  @@index([institutionId, employerOrgId])
  @@index([institutionId, studentId])
}

model HoursEntry {
  id            String   @id @default(uuid())
  institutionId String
  placementId   String
  weekLabel     String
  hours         Float
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  placement     Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([institutionId, placementId])
}

model PlacementEvaluation {
  id            String   @id @default(uuid())
  institutionId String
  placementId   String
  studentName   String
  status        String   @default("due")
  score         Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  placement     Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([institutionId, placementId])
}

model AffiliationAgreement {
  id            String   @id @default(uuid())
  institutionId String
  employerOrgId String
  title         String
  status        String   @default("active")
  renewsOn      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  employerOrg   EmployerOrg @relation(fields: [employerOrgId], references: [id], onDelete: Cascade)

  @@index([institutionId, employerOrgId])
}

model Rubric {
  id            String            @id @default(uuid())
  institutionId String
  title         String
  description   String?
  maxScore      Float
  status        String            @default("published")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  rowVersion    Int               @default(1)
  criteria      RubricCriterion[]
  assignments   Assignment[]

  @@index([institutionId, status])
}

model RubricCriterion {
  id            String   @id @default(uuid())
  institutionId String
  rubricId      String
  label         String
  description   String
  maxPoints     Float
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  rubric        Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@index([institutionId, rubricId])
}

model AdvisingAppointment {
  id              String   @id @default(uuid())
  institutionId   String
  studentId       String
  advisorPersonId String?
  topic           String
  startsAt        DateTime
  status          String   @default("requested")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rowVersion      Int      @default(1)
  student         Student  @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, startsAt])
  @@index([institutionId, status])
}

model SuccessCase {
  id            String              @id @default(uuid())
  institutionId String
  studentId     String
  level         String
  status        String              @default("open")
  summary       String
  signalsJson   String              @default("[]")
  ownerPersonId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  rowVersion    Int                 @default(1)
  student       Student             @relation(fields: [studentId], references: [id])
  tasks         InterventionTask[]

  @@index([institutionId, studentId, status])
  @@index([institutionId, status])
}

model InterventionTask {
  id            String      @id @default(uuid())
  institutionId String
  caseId        String
  title         String
  status        String      @default("pending")
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rowVersion    Int         @default(1)
  successCase   SuccessCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([institutionId, caseId])
}

model CourseCorequisite {
  id                   String   @id @default(uuid())
  institutionId        String
  courseId             String
  corequisiteCourseId  String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  rowVersion           Int      @default(1)
  course               Course   @relation("CourseHasCoreqs", fields: [courseId], references: [id])
  corequisiteCourse    Course   @relation("CourseIsCoreq", fields: [corequisiteCourseId], references: [id])

  @@unique([institutionId, courseId, corequisiteCourseId])
  @@index([institutionId])
}

model TransferCredit {
  id            String   @id @default(uuid())
  institutionId String
  studentId     String
  courseId      String?
  externalCode  String
  externalTitle String
  credits       Float
  status        String   @default("accepted")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  student       Student  @relation(fields: [studentId], references: [id])
  course        Course?  @relation(fields: [courseId], references: [id])

  @@index([institutionId, studentId])
}

model CourseOffering {
  id            String   @id @default(uuid())
  institutionId String
  courseId      String
  termCode      String
  termName      String
  seatsOpen     Int      @default(0)
  seatsTotal    Int      @default(30)
  status        String   @default("published")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)
  course        Course   @relation(fields: [courseId], references: [id])

  @@unique([institutionId, courseId, termCode])
  @@index([institutionId, termCode])
}

model CareerOpportunity {
  id            String   @id @default(uuid())
  institutionId String
  title         String
  employerName  String
  skillsJson    String   @default("[]")
  programCodesJson String @default("[]")
  status        String   @default("open")
  href          String   @default("/student/f/st-20-career")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rowVersion    Int      @default(1)

  @@index([institutionId, status])
}

model Assessment {
  id              String              @id @default(uuid())
  institutionId   String
  sectionId       String
  title           String
  opensAt         DateTime
  closesAt        DateTime
  durationMinutes Int                 @default(60)
  maxAttempts     Int                 @default(1)
  status          String              @default("published")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  rowVersion      Int                 @default(1)
  section         Section             @relation(fields: [sectionId], references: [id])
  attempts        AssessmentAttempt[]

  @@index([institutionId, sectionId])
  @@index([institutionId, status, opensAt])
}

model AssessmentAttempt {
  id            String     @id @default(uuid())
  institutionId String
  assessmentId  String
  studentId     String
  status        String     @default("open")
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  rowVersion    Int        @default(1)
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, status])
  @@index([assessmentId, studentId])
}

model AttendanceRecord {
  id             String        @id @default(uuid())
  institutionId  String
  studentId      String
  sectionId      String
  classSessionId String?
  meetingLabel   String
  status         String        @default("present")
  recordedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rowVersion     Int           @default(1)
  student        Student       @relation(fields: [studentId], references: [id])
  section        Section       @relation(fields: [sectionId], references: [id])
  classSession   ClassSession? @relation(fields: [classSessionId], references: [id])

  @@index([institutionId, studentId])
  @@index([sectionId, recordedAt])
}

model LabNotebookEntry {
  id             String       @id @default(uuid())
  institutionId  String
  studentId      String
  classSessionId String
  title          String
  body           String       @default("")
  version        Int          @default(1)
  lockedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  rowVersion     Int          @default(1)
  student        Student      @relation(fields: [studentId], references: [id])
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])

  @@unique([studentId, classSessionId])
  @@index([institutionId, studentId])
}

model ServiceRequest {
  id                String   @id @default(uuid())
  institutionId     String
  studentId         String
  type              String
  subject           String
  details           String
  status            String   @default("open")
  approvalRequestId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rowVersion        Int      @default(1)
  student           Student  @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, status])
}

model FinanceLedgerEntry {
  id            String    @id @default(uuid())
  institutionId String
  studentId     String
  label         String
  amountCad     Float
  kind          String
  status        String    @default("open")
  dueAt         DateTime?
  postedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  student       Student   @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, postedAt])
}

model CredentialRecord {
  id            String    @id @default(uuid())
  institutionId String
  studentId     String
  title         String
  status        String    @default("pending")
  detail        String?
  earnedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rowVersion    Int       @default(1)
  student       Student   @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId, status])
}
